{
  "name": "cypher-foundry-vtt",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node scripts/run-isolated-validation.mjs",
    "lint": "eslint cypher.mjs module scripts tests *.config.mjs --max-warnings=0",
    "typecheck": "tsc -p jsconfig.rules.json",
    "test:all": "node scripts/run-tests.mjs all",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:content": "node scripts/run-tests.mjs content",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:behavior": "node scripts/run-tests.mjs behavior",
    "test:e2e": "node scripts/run-foundry-e2e.mjs",
    "check:e2e-syntax": "node scripts/check-e2e-syntax.mjs",
    "audit:architecture": "node scripts/audit-architecture-dependencies.mjs",
    "audit:crd": "node scripts/audit-crd-compendiums.mjs",
    "build:lang": "node scripts/build-locales.mjs",
    "check:lang": "node scripts/build-locales.mjs --check",
    "audit:i18n": "node scripts/review-translations.mjs",
    "preview:translations": "node scripts/review-translations.mjs --preview",
    "build:packs": "node scripts/build-packs.mjs",
    "package": "node scripts/package.mjs",
    "migrate:packs": "node scripts/migrate-ability-sources.mjs",
    "audit:public-data": "node scripts/audit-public-data.mjs",
    "test:coverage": "node scripts/run-test-coverage.mjs",
    "check:e2e-browser": "node scripts/check-playwright-browser.mjs",
    "check:system-syntax": "node scripts/check-system-syntax.mjs",
    "test:e2e-debug": "node scripts/run-foundry-e2e.mjs --debug-foundry-logs",
    "test:sources": "node scripts/run-tests.mjs sources",
    "test:runtime": "node scripts/run-tests.mjs runtime",
    "test:build": "node scripts/run-tests.mjs build",
    "audit:ids": "node scripts/audit-compendium-identities.mjs",
    "audit:callouts": "node scripts/audit-crd-callouts.mjs",
    "audit:terminology": "node scripts/audit-terminology.mjs",
    "audit:abilities-pr7": "node scripts/audit-ability-batch-1.mjs",
    "audit:abilities-pr8": "node scripts/audit-ability-batch-2.mjs",
    "audit:abilities-pr9": "node scripts/audit-ability-batch-3.mjs",
    "audit:abilities-pr10": "node scripts/audit-ability-batch-4.mjs",
    "audit:types-foci-pr11": "node scripts/audit-type-focus-pr11.mjs",
    "audit:equipment-pr12": "node scripts/audit-equipment-pr12.mjs"
  },
  "dependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "eslint": "10.12.0",
    "globals": "16.5.0",
    "typescript": "5.9.3"
  }
}
