{
  "name": "cypher-foundry-vtt",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node scripts/run-isolated-validation.mjs",
    "lint": "eslint cypher.mjs module scripts tests *.config.mjs --max-warnings=0",
    "typecheck": "tsc -p jsconfig.rules.json",
    "test:all": "node --test --test-reporter=spec tests/rules/*.test.mjs tests/applications/*.test.mjs tests/documents/*.test.mjs tests/migrations/*.test.mjs tests/content/*.test.mjs tests/integration/*.test.mjs tests/behaviors/*.test.mjs",
    "test:unit": "node --test --test-reporter=spec tests/rules/*.test.mjs tests/applications/*.test.mjs tests/documents/*.test.mjs tests/migrations/*.test.mjs",
    "test:content": "node --test --test-reporter=spec tests/content/*.test.mjs",
    "test:integration": "node --test --test-reporter=spec tests/integration/*.test.mjs",
    "test:behavior": "node --test --test-reporter=spec tests/behaviors/*.test.mjs",
    "test:e2e": "node scripts/run-foundry-e2e.mjs",
    "check:e2e-syntax": "node --check scripts/run-foundry-e2e.mjs && node --check playwright.config.mjs && node --check tests/e2e/foundry-session.mjs && node --check tests/e2e/foundry-runtime.spec.mjs && node --check tests/e2e/foundry-gameplay.spec.mjs",
    "audit:architecture": "node scripts/audit-architecture-dependencies.mjs",
    "audit:crd": "node scripts/audit-crd-compendiums.mjs",
    "build:packs": "node scripts/build-packs.mjs",
    "package": "node scripts/package.mjs",
    "migrate:packs": "node scripts/migrate-ability-sources.mjs",
    "audit:public-data": "node scripts/audit-public-data.mjs",
    "test:coverage": "node scripts/run-test-coverage.mjs",
    "check:e2e-browser": "node scripts/check-playwright-browser.mjs",
    "check:system-syntax": "node scripts/check-system-syntax.mjs",
    "test:e2e-debug": "node scripts/run-foundry-e2e.mjs --debug-foundry-logs"
  },
  "dependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "eslint": "10.12.0",
    "globals": "16.5.0",
    "typescript": "5.9.3"
  }
}
