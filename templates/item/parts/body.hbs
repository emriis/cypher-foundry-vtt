{{!-- Item details are prepared by CypherItemSheet and rendered from their registered data models. --}}
<section class="item-body">

  {{#ifEquals item.type "type"}}
  <div class="form-group description-group type-description">
    <label>{{localize 'CYPHER.Description'}}</label>
    <prose-mirror name="system.description" value="{{system.description}}"></prose-mirror>
  </div>

  <section class="type-classification" aria-label="{{localize 'CYPHER.Type.Label'}}">
    <div class="type-meta-field">
      <span>{{localize 'CYPHER.Tier'}}</span>
      <strong>{{system.tier}}</strong>
    </div>
    <div class="type-meta-field">
      <span>{{localize 'CYPHER.Type.Genre'}}</span>
      <strong>{{typeView.genre}}</strong>
    </div>
    <div class="type-meta-field">
      <span>{{localize 'CYPHER.Type.Subgenre'}}</span>
      <strong>{{typeView.subgenre}}</strong>
    </div>
  </section>

  <section class="type-benefits">
    <h3>{{localize 'CYPHER.Type.PoolBonuses'}}</h3>
    <dl class="type-value-grid">
      {{#each typeView.poolBonuses as |bonus|}}
      <div><dt>{{bonus.label}}</dt><dd>+{{bonus.value}}</dd></div>
      {{/each}}
    </dl>
  </section>

  <section class="type-benefits">
    <h3>{{localize 'CYPHER.Type.WoundBonuses'}}</h3>
    <dl class="type-value-grid">
      {{#each typeView.woundBonuses as |bonus|}}
      <div><dt>{{bonus.label}}</dt><dd>+{{bonus.value}}</dd></div>
      {{/each}}
    </dl>
  </section>

  {{#if typeView.edgeChoice}}
  <section class="type-benefits type-choice-benefit">
    <h3>{{localize 'CYPHER.Edge'}}</h3>
    <p>+{{typeView.edgeChoice}} {{localize 'CYPHER.Type.EdgeChoice'}}</p>
    {{#if typeView.statOptions.length}}
    <ul class="type-chip-list">
      {{#each typeView.statOptions as |stat|}}<li>{{stat}}</li>{{/each}}
    </ul>
    {{/if}}
  </section>
  {{/if}}

  {{#if typeView.weaponCategories.length}}
  <section class="type-benefits">
    <h3>{{localize 'CYPHER.Type.WeaponTraining'}}</h3>
    <ul class="type-chip-list">
      {{#each typeView.weaponCategories as |category|}}<li>{{category}}</li>{{/each}}
    </ul>
  </section>
  {{/if}}

  {{#if typeView.armorCategories.length}}
  <section class="type-benefits">
    <h3>{{localize 'CYPHER.Type.ArmorTraining'}}</h3>
    <ul class="type-chip-list">
      {{#each typeView.armorCategories as |category|}}<li>{{category}}</li>{{/each}}
    </ul>
  </section>
  {{/if}}

  {{#if typeView.weaponFamilies.length}}
  <section class="type-benefits">
    <h3>{{localize 'CYPHER.Type.WeaponFamilies'}}</h3>
    <ul class="type-chip-list">
      {{#each typeView.weaponFamilies as |family|}}<li>{{family}}</li>{{/each}}
    </ul>
  </section>
  {{/if}}

  {{#if typeView.skillOptions.length}}
  <section class="type-benefits">
    <h3>{{localize 'CYPHER.Type.SkillOptions'}}</h3>
    <ul class="type-detail-list">
      {{#each typeView.skillOptions as |skill|}}<li>{{skill}}</li>{{/each}}
    </ul>
  </section>
  {{/if}}

  {{#if typeView.abilities.length}}
  <section class="type-abilities">
    <h3>{{localize 'CYPHER.Type.Abilities'}}</h3>
    {{#each typeView.abilities as |ability|}}
    <article class="type-ability">
      <header>
        <h4>{{ability.name}}</h4>
        <span>{{ability.tierLabel}}</span>
      </header>
      <div class="type-ability-tags">
        <span>{{ability.costLabel}}</span>
        {{#if ability.costOptionsLabel}}<span>{{ability.costOptionsLabel}}</span>{{/if}}
        {{#if ability.actionLabel}}<span>{{ability.actionLabel}}</span>{{/if}}
        {{#if ability.enabler}}<span>{{localize 'CYPHER.Type.Enabler'}}</span>{{/if}}
        {{#if ability.repeatable}}<span>{{localize 'CYPHER.Type.Repeatable'}}</span>{{/if}}
      </div>
      {{#if ability.prerequisites.length}}
      <p class="type-ability-prerequisites"><strong>{{localize 'CYPHER.Type.Prerequisites'}}:</strong> {{ability.prerequisitesLabel}}</p>
      {{/if}}
      <div class="type-ability-description">{{{ability.enrichedDescription}}}</div>
    </article>
    {{/each}}
  </section>
  {{/if}}

  {{else}}
  {{#ifEquals item.type "focus"}}
  <div class="form-group description-group type-description">
    <label>{{localize 'CYPHER.Description'}}</label>
    <prose-mirror name="system.description" value="{{system.description}}"></prose-mirror>
  </div>

  <section class="focus-flowchart">
    <h3>{{localize 'CYPHER.FocusSheet.Abilities'}}</h3>
    {{#each focusView.tiers as |tier|}}
    <section class="focus-tier">
      <h4>{{tier.label}}</h4>
      <div class="focus-tier-abilities">
        {{#each tier.abilities as |ability|}}
        <article class="type-ability">
          <header>
            <h4>{{ability.name}}</h4>
            <span>{{ability.tierLabel}}</span>
          </header>
          <div class="type-ability-tags">
            <span>{{ability.costLabel}}</span>
            {{#if ability.costOptionsLabel}}<span>{{ability.costOptionsLabel}}</span>{{/if}}
            {{#if ability.actionLabel}}<span>{{ability.actionLabel}}</span>{{/if}}
            {{#if ability.enabler}}<span>{{localize 'CYPHER.FocusSheet.Enabler'}}</span>{{/if}}
            {{#if ability.repeatable}}<span>{{localize 'CYPHER.FocusSheet.Repeatable'}}</span>{{/if}}
          </div>
          {{#if ability.prerequisites.length}}
          <div class="focus-prerequisites">
            <strong>{{localize 'CYPHER.FocusSheet.OnePrerequisite'}}:</strong>
            <ul class="type-chip-list">
              {{#each ability.prerequisites as |prerequisite|}}<li>{{prerequisite}}</li>{{/each}}
            </ul>
          </div>
          {{/if}}
          {{#if ability.weaponCategories.length}}
          <p class="focus-grant"><strong>{{localize 'CYPHER.FocusSheet.WeaponCategories'}}:</strong> {{ability.weaponCategoriesLabel}}</p>
          {{/if}}
          {{#if ability.armorCategories.length}}
          <p class="focus-grant"><strong>{{localize 'CYPHER.FocusSheet.ArmorCategories'}}:</strong> {{ability.armorCategoriesLabel}}</p>
          {{/if}}
          {{#if ability.weaponFamilies.length}}
          <p class="focus-grant"><strong>{{localize 'CYPHER.FocusSheet.WeaponFamilies'}}:</strong> {{ability.weaponFamiliesLabel}}</p>
          {{/if}}
          {{#if ability.weaponSkills.length}}
          <p class="focus-grant"><strong>{{localize 'CYPHER.FocusSheet.WeaponSkills'}}:</strong> {{ability.weaponSkillsLabel}}</p>
          {{/if}}
          {{#if ability.chooseWeaponAttackCategory}}
          <p class="focus-grant">{{localize 'CYPHER.FocusSheet.ChooseWeaponAttackCategory'}}</p>
          {{/if}}
          {{#if ability.grantedArmorCategory}}
          <p class="focus-grant"><strong>{{localize 'CYPHER.FocusSheet.GrantedArmor'}}:</strong> {{ability.grantedArmorCategory}}</p>
          {{/if}}
          <div class="type-ability-description">{{{ability.enrichedDescription}}}</div>
        </article>
        {{/each}}
      </div>
    </section>
    {{/each}}
    {{#unless focusView.tiers.length}}
    {{#if system.abilities.length}}
    <div class="focus-tier-abilities">
      {{#each system.abilities as |ability|}}
      <article class="type-ability">
        <header>
          <h4>{{ability.name}}</h4>
          <span>{{localize 'CYPHER.Tier'}} {{ability.tier}}</span>
        </header>
        <div class="type-ability-tags">
          {{#if ability.cost.amount}}
          <span>{{localize 'CYPHER.Ability.CostStat'}}: {{ability.cost.amount}}
            {{#ifEquals ability.cost.stat "choice"}}{{localize 'CYPHER.FocusSheet.AnyPool'}}{{else}}{{localize (concat "CYPHER.Stat." ability.cost.stat)}}{{/ifEquals}}
          </span>
          {{else}}
          <span>{{localize 'CYPHER.FocusSheet.NoPoolCost'}}</span>
          {{/if}}
          {{#if ability.enabler}}<span>{{localize 'CYPHER.FocusSheet.Enabler'}}</span>{{/if}}
          {{#if ability.repeatable}}<span>{{localize 'CYPHER.FocusSheet.Repeatable'}}</span>{{/if}}
        </div>
        {{#if ability.prerequisites.length}}
        <div class="focus-prerequisites">
          <strong>{{localize 'CYPHER.FocusSheet.OnePrerequisite'}}:</strong>
          <ul class="type-chip-list">
            {{#each ability.prerequisites as |prerequisite|}}<li>{{prerequisite}}</li>{{/each}}
          </ul>
        </div>
        {{/if}}
        {{#if ability.freeWeaponCategories.length}}
        <p class="focus-grant"><strong>{{localize 'CYPHER.FocusSheet.WeaponCategories'}}:</strong>
          {{#each ability.freeWeaponCategories as |category|}}{{localize (concat "CYPHER.Type.WeaponCategory." category)}}{{#unless @last}}, {{/unless}}{{/each}}
        </p>
        {{/if}}
        {{#if ability.freeArmorCategories.length}}
        <p class="focus-grant"><strong>{{localize 'CYPHER.FocusSheet.ArmorCategories'}}:</strong>
          {{#each ability.freeArmorCategories as |category|}}{{localize (concat "CYPHER.Type.ArmorCategory." category)}}{{#unless @last}}, {{/unless}}{{/each}}
        </p>
        {{/if}}
        {{#if ability.freeWeaponFamilies.length}}
        <p class="focus-grant"><strong>{{localize 'CYPHER.FocusSheet.WeaponFamilies'}}:</strong>
          {{#each ability.freeWeaponFamilies as |family|}}{{localize (concat "CYPHER.WeaponFamily." family)}}{{#unless @last}}, {{/unless}}{{/each}}
        </p>
        {{/if}}
        {{#if ability.freeWeaponSkillCategories.length}}
        <p class="focus-grant"><strong>{{localize 'CYPHER.FocusSheet.WeaponSkills'}}:</strong>
          {{#each ability.freeWeaponSkillCategories as |category|}}{{localize (concat "CYPHER.AttackSkill." category)}}{{#unless @last}}, {{/unless}}{{/each}}
        </p>
        {{/if}}
        {{#if ability.chooseWeaponAttackCategory}}
        <p class="focus-grant">{{localize 'CYPHER.FocusSheet.ChooseWeaponAttackCategory'}}</p>
        {{/if}}
        {{#if ability.grantedArmorItemCategory}}
        <p class="focus-grant"><strong>{{localize 'CYPHER.FocusSheet.GrantedArmor'}}:</strong> {{localize (concat "CYPHER.Armor." ability.grantedArmorItemCategory)}}</p>
        {{/if}}
        <div class="type-ability-description">{{{ability.description}}}</div>
      </article>
      {{/each}}
    </div>
    {{else}}
    <p class="focus-empty-state">{{localize 'CYPHER.FocusSheet.NoAbilities'}}</p>
    {{/if}}
    {{/unless}}
  </section>

  {{else}}
  {{#ifEquals item.type "descriptor"}}
  <div class="form-group description-group type-description">
    <label>{{localize 'CYPHER.Description'}}</label>
    <prose-mirror name="system.description" value="{{system.description}}"></prose-mirror>
  </div>

  <section class="type-classification descriptor-classification" aria-label="{{localize 'CYPHER.Descriptor.Label'}}">
    <div class="type-meta-field">
      <span>{{localize 'CYPHER.Descriptor.Label'}}</span>
      <strong>{{descriptorView.category}}</strong>
    </div>
    {{#if descriptorView.genres.length}}
    <div class="type-meta-field">
      <span>{{localize 'CYPHER.Descriptor.Genres'}}</span>
      <ul class="type-chip-list">
        {{#each descriptorView.genres as |genre|}}<li>{{genre}}</li>{{/each}}
      </ul>
    </div>
    {{else}}
    <div class="type-meta-field">
      <span>{{localize 'CYPHER.Descriptor.Genres'}}</span>
      <strong>{{localize 'CYPHER.Descriptor.AllGenres'}}</strong>
    </div>
    {{/if}}
    {{#if descriptorView.grantsSecondDescriptor}}
    <div class="type-meta-field">
      <span>{{localize 'CYPHER.Descriptor.SecondDescriptorGrant'}}</span>
      <strong>{{localize 'CYPHER.Descriptor.Granted'}}</strong>
    </div>
    {{/if}}
  </section>

  {{#if descriptorView.statAmount}}
  <section class="type-benefits">
    <h3>{{localize 'CYPHER.Descriptor.StatAmount'}} +{{descriptorView.statAmount}}</h3>
    <ul class="type-chip-list">
      {{#each descriptorView.statOptions as |stat|}}<li>{{stat}}</li>{{/each}}
    </ul>
  </section>
  {{/if}}

  {{#if descriptorView.skillOptions.length}}
  <section class="type-benefits">
    <h3>{{localize 'CYPHER.Descriptor.SkillOptions'}}</h3>
    <ul class="type-chip-list">
      {{#each descriptorView.skillOptions as |skill|}}<li>{{skill}}</li>{{/each}}
    </ul>
  </section>
  {{/if}}

  {{#if descriptorView.grantedSkills.length}}
  <section class="type-benefits">
    <h3>{{localize 'CYPHER.Descriptor.FixedSkills'}}</h3>
    <ul class="type-chip-list">
      {{#each descriptorView.grantedSkills as |skill|}}<li>{{skill}}</li>{{/each}}
    </ul>
  </section>
  {{/if}}

  {{#if descriptorView.benefits.length}}
  <section class="descriptor-benefits">
    <h3>{{localize 'CYPHER.Descriptor.Benefits'}}</h3>
    {{#each descriptorView.benefits as |benefit|}}
    <article class="descriptor-benefit">
      <h4>{{benefit.name}}</h4>
      <div class="type-ability-description">{{{benefit.enrichedDescription}}}</div>
    </article>
    {{/each}}
  </section>
  {{/if}}

  {{else}}
  {{#ifEquals item.type "skill"}}
  <div class="form-group">
    <label>{{localize 'CYPHER.Stat.Label'}}</label>
    <select name="system.stat">
      <option value="might" {{#ifEquals system.stat "might"}}selected{{/ifEquals}}>{{localize 'CYPHER.Stat.might'}}</option>
      <option value="speed" {{#ifEquals system.stat "speed"}}selected{{/ifEquals}}>{{localize 'CYPHER.Stat.speed'}}</option>
      <option value="intellect" {{#ifEquals system.stat "intellect"}}selected{{/ifEquals}}>{{localize 'CYPHER.Stat.intellect'}}</option>
      <option value="none" {{#ifEquals system.stat "none"}}selected{{/ifEquals}}>{{localize 'CYPHER.Stat.none'}}</option>
    </select>
  </div>
  <div class="form-group">
    <label>{{localize 'CYPHER.Skill.Level'}}</label>
    <select name="system.level">
      <option value="inability" {{#ifEquals system.level "inability"}}selected{{/ifEquals}}>{{localize 'CYPHER.SkillLevel.inability'}}</option>
      <option value="practiced" {{#ifEquals system.level "practiced"}}selected{{/ifEquals}}>{{localize 'CYPHER.SkillLevel.practiced'}}</option>
      <option value="trained" {{#ifEquals system.level "trained"}}selected{{/ifEquals}}>{{localize 'CYPHER.SkillLevel.trained'}}</option>
      <option value="specialized" {{#ifEquals system.level "specialized"}}selected{{/ifEquals}}>{{localize 'CYPHER.SkillLevel.specialized'}}</option>
      <option value="expert" {{#ifEquals system.level "expert"}}selected{{/ifEquals}}>{{localize 'CYPHER.SkillLevel.expert'}}</option>
    </select>
  </div>
  <div class="form-group">
    <label>{{localize 'CYPHER.AttackSkill.Category'}}</label>
    <select name="system.attackCategory">
      <option value="" {{#ifEquals system.attackCategory ""}}selected{{/ifEquals}}>{{localize 'CYPHER.AttackSkill.none'}}</option>
      {{#each config.attackSkillCategories as |category|}}
      <option value="{{category}}" {{#ifEquals ../system.attackCategory category}}selected{{/ifEquals}}>{{localize (concat "CYPHER.AttackSkill." category)}}</option>
      {{/each}}
    </select>
  </div>
  {{/ifEquals}}

  {{#ifEquals item.type "ability"}}
  <div class="form-group">
    <label>{{localize 'CYPHER.Ability.Source'}}</label>
    <input name="system.source" type="text" value="{{system.source}}"/>
  </div>
  <div class="form-group">
    <label>{{localize 'CYPHER.Tier'}}</label>
    <input name="system.tier" type="number" value="{{system.tier}}" min="1" max="6"/>
  </div>
  <div class="form-group inline">
    <label>{{localize 'CYPHER.Ability.CostStat'}}</label>
    <select name="system.cost.stat">
      <option value="none" {{#ifEquals system.cost.stat "none"}}selected{{/ifEquals}}>{{localize 'CYPHER.Stat.none'}}</option>
      <option value="might" {{#ifEquals system.cost.stat "might"}}selected{{/ifEquals}}>{{localize 'CYPHER.Stat.might'}}</option>
      <option value="speed" {{#ifEquals system.cost.stat "speed"}}selected{{/ifEquals}}>{{localize 'CYPHER.Stat.speed'}}</option>
      <option value="intellect" {{#ifEquals system.cost.stat "intellect"}}selected{{/ifEquals}}>{{localize 'CYPHER.Stat.intellect'}}</option>
    </select>
    <input name="system.cost.amount" type="number" value="{{system.cost.amount}}" min="0"/>
  </div>
  <div class="form-group">
    <label>{{localize 'CYPHER.Ability.Action'}}</label>
    <select name="system.action">
      <option value="none" {{#ifEquals system.action "none"}}selected{{/ifEquals}}>{{localize 'CYPHER.Ability.ActionNone'}}</option>
      <option value="action" {{#ifEquals system.action "action"}}selected{{/ifEquals}}>{{localize 'CYPHER.Ability.ActionStandard'}}</option>
      <option value="firstAction" {{#ifEquals system.action "firstAction"}}selected{{/ifEquals}}>{{localize 'CYPHER.Ability.ActionFirst'}}</option>
      <option value="lastAction" {{#ifEquals system.action "lastAction"}}selected{{/ifEquals}}>{{localize 'CYPHER.Ability.ActionLast'}}</option>
    </select>
  </div>
  {{/ifEquals}}

  {{#ifEquals item.type "ability"}}
  <section class="ability-meta">
    {{#if system.action}}<span>{{localize 'CYPHER.Ability.Action'}}: {{#ifEquals system.action "action"}}{{localize 'CYPHER.Ability.ActionStandard'}}{{/ifEquals}}{{#ifEquals system.action "firstAction"}}{{localize 'CYPHER.Ability.ActionFirst'}}{{/ifEquals}}{{#ifEquals system.action "lastAction"}}{{localize 'CYPHER.Ability.ActionLast'}}{{/ifEquals}}</span>{{/if}}
    {{#if system.enabler}}<span>{{localize 'CYPHER.Ability.ActionEnabler'}}</span>{{/if}}
  </section>
  {{/ifEquals}}

  {{#if abilityView.effects.length}}
  <section class="ability-effects">
    <h3>{{localize 'CYPHER.Ability.ChooseEffect'}}</h3>
    {{#each abilityView.effects as |effect|}}
    <article class="ability-effect">
      <h4>{{effect.name}}</h4>
      <div>{{{effect.description}}}</div>
      {{#if effect.effort}}<p><strong>{{localize 'CYPHER.Ability.Effort'}}:</strong> {{effect.effort}}</p>{{/if}}
    </article>
    {{/each}}
  </section>
  {{/if}}

  {{#if abilityView.rollTables.length}}
  <section class="ability-roll-tables">
    <h3>{{localize 'CYPHER.Ability.RollTable'}}</h3>
    {{#each abilityView.rollTables as |table|}}
    <article class="ability-roll-table">
      <h4>{{table.name}} <small>{{table.formula}}</small></h4>
      <ul>
        {{#each table.results as |result|}}
        <li><strong>{{result.min}}–{{result.max}}</strong> {{result.description}}</li>
        {{/each}}
      </ul>
    </article>
    {{/each}}
  </section>
  {{/if}}

  {{#ifEquals item.type "cypher"}}
  <div class="form-group">
    <label>{{localize 'CYPHER.Cypher.Type'}}</label>
    <select name="system.cypherType">
      <option value="subtle" {{#ifEquals system.cypherType "subtle"}}selected{{/ifEquals}}>{{localize 'CYPHER.Cypher.Subtle'}}</option>
      <option value="manifest" {{#ifEquals system.cypherType "manifest"}}selected{{/ifEquals}}>{{localize 'CYPHER.Cypher.Manifest'}}</option>
    </select>
  </div>
  <div class="form-group">
    <label>{{localize 'CYPHER.Level'}}</label>
    <input name="system.level" type="text" value="{{system.level}}"/>
  </div>
  <div class="form-group inline">
    <label><input type="checkbox" name="system.internal" {{#if system.internal}}checked{{/if}}/> {{localize 'CYPHER.Cypher.Internal'}}</label>
    <label><input type="checkbox" name="system.depleted" {{#if system.depleted}}checked{{/if}}/> {{localize 'CYPHER.Cypher.Depleted'}}</label>
  </div>
  {{/ifEquals}}

  {{#ifEquals item.type "artifact"}}
  <div class="form-group">
    <label>{{localize 'CYPHER.Level'}}</label>
    <input name="system.level" type="text" value="{{system.level}}"/>
  </div>
  <div class="form-group">
    <label>{{localize 'CYPHER.Artifact.Form'}}</label>
    <input name="system.form" type="text" value="{{system.form}}"/>
  </div>
  <div class="form-group inline">
    <label>{{localize 'CYPHER.Depletion.Die'}}</label>
    <select name="system.depletionDie">
      <option value="none" {{#ifEquals system.depletionDie "none"}}selected{{/ifEquals}}>{{localize 'CYPHER.Depletion.none'}}</option>
      <option value="d6" {{#ifEquals system.depletionDie "d6"}}selected{{/ifEquals}}>1d6</option>
      <option value="d8" {{#ifEquals system.depletionDie "d8"}}selected{{/ifEquals}}>1d8</option>
      <option value="d10" {{#ifEquals system.depletionDie "d10"}}selected{{/ifEquals}}>1d10</option>
      <option value="d12" {{#ifEquals system.depletionDie "d12"}}selected{{/ifEquals}}>1d12</option>
      <option value="d20" {{#ifEquals system.depletionDie "d20"}}selected{{/ifEquals}}>1d20</option>
    </select>
    <label>{{localize 'CYPHER.Depletion.Threshold'}}
      <input name="system.depletionThreshold" type="number" value="{{system.depletionThreshold}}" min="1"/>
    </label>
  </div>
  <div class="form-group inline">
    <label><input type="checkbox" name="system.identified" {{#if system.identified}}checked{{/if}}/> {{localize 'CYPHER.Identified'}}</label>
    <label><input type="checkbox" name="system.depleted" {{#if system.depleted}}checked{{/if}}/> {{localize 'CYPHER.Depletion.Depleted'}}</label>
  </div>
  <p class="depletion-hint">{{localize 'CYPHER.Depletion.Hint'}}</p>
  {{/ifEquals}}

  {{#ifEquals item.type "attack"}}
  <div class="form-group">
    <label>{{localize 'CYPHER.Attack.Type'}}</label>
    <select name="system.attackType">
      <option value="light" {{#ifEquals system.attackType "light"}}selected{{/ifEquals}}>{{localize 'CYPHER.AttackType.light'}}</option>
      <option value="medium" {{#ifEquals system.attackType "medium"}}selected{{/ifEquals}}>{{localize 'CYPHER.AttackType.medium'}}</option>
      <option value="heavy" {{#ifEquals system.attackType "heavy"}}selected{{/ifEquals}}>{{localize 'CYPHER.AttackType.heavy'}}</option>
    </select>
  </div>
  <div class="form-group">
    <label>{{localize 'CYPHER.WeaponFamily.Label'}}</label>
    <select name="system.weaponFamily">
      <option value="" {{#ifEquals system.weaponFamily ""}}selected{{/ifEquals}}>{{localize 'CYPHER.WeaponFamily.none'}}</option>
      <option value="axes" {{#ifEquals system.weaponFamily "axes"}}selected{{/ifEquals}}>{{localize 'CYPHER.WeaponFamily.axes'}}</option>
      <option value="knives" {{#ifEquals system.weaponFamily "knives"}}selected{{/ifEquals}}>{{localize 'CYPHER.WeaponFamily.knives'}}</option>
      <option value="swords" {{#ifEquals system.weaponFamily "swords"}}selected{{/ifEquals}}>{{localize 'CYPHER.WeaponFamily.swords'}}</option>
      <option value="firearms" {{#ifEquals system.weaponFamily "firearms"}}selected{{/ifEquals}}>{{localize 'CYPHER.WeaponFamily.firearms'}}</option>
    </select>
  </div>
  <div class="form-group">
    <label>{{localize 'CYPHER.AttackSkill.Category'}}</label>
    <select name="system.attackSkillCategory">
      <option value="" {{#ifEquals system.attackSkillCategory ""}}selected{{/ifEquals}}>{{localize 'CYPHER.AttackSkill.none'}}</option>
      {{#each config.attackSkillCategories as |category|}}
      <option value="{{category}}" {{#ifEquals ../system.attackSkillCategory category}}selected{{/ifEquals}}>{{localize (concat "CYPHER.AttackSkill." category)}}</option>
      {{/each}}
    </select>
  </div>
  <div class="form-group">
    <label>{{localize 'CYPHER.Damage'}}</label>
    <input name="system.damage" type="number" value="{{system.damage}}" min="0"/>
  </div>
  <div class="form-group">
    <label>{{localize 'CYPHER.Stat.Label'}}</label>
    <select name="system.stat">
      <option value="might" {{#ifEquals system.stat "might"}}selected{{/ifEquals}}>{{localize 'CYPHER.Stat.might'}}</option>
      <option value="speed" {{#ifEquals system.stat "speed"}}selected{{/ifEquals}}>{{localize 'CYPHER.Stat.speed'}}</option>
    </select>
  </div>
  <div class="form-group inline">
    <label><input type="checkbox" name="system.freelyUsable" {{#if system.freelyUsable}}checked{{/if}}/> {{localize 'CYPHER.Attack.FreelyUsable'}}</label>
  </div>
  {{/ifEquals}}

  {{#ifEquals item.type "armor"}}
  <div class="form-group">
    <label>{{localize 'CYPHER.Armor.Category'}}</label>
    <select name="system.category">
      <option value="light" {{#ifEquals system.category "light"}}selected{{/ifEquals}}>{{localize 'CYPHER.Armor.light'}}</option>
      <option value="medium" {{#ifEquals system.category "medium"}}selected{{/ifEquals}}>{{localize 'CYPHER.Armor.medium'}}</option>
      <option value="heavy" {{#ifEquals system.category "heavy"}}selected{{/ifEquals}}>{{localize 'CYPHER.Armor.heavy'}}</option>
    </select>
  </div>
  <div class="form-group inline">
    <label><input type="checkbox" name="system.freelyUsable" {{#if system.freelyUsable}}checked{{/if}}/> {{localize 'CYPHER.Armor.FreelyUsable'}}</label>
    <label><input type="checkbox" name="system.equipped" {{#if system.equipped}}checked{{/if}}/> {{localize 'CYPHER.Equipped'}}</label>
  </div>
  <div class="form-group">
    <label>{{localize 'CYPHER.Armor.BlockEaseDamage'}}</label>
    <input name="system.blockEaseDamage" type="number" value="{{system.blockEaseDamage}}" min="0"/>
  </div>
  <p class="armor-item-hint">{{localize 'CYPHER.Armor.ItemHint'}}</p>
  {{/ifEquals}}

  {{#ifEquals item.type "shield"}}
  <p class="shield-hint">{{localize 'CYPHER.Shield.SheetHint'}}</p>
  <div class="form-group inline">
    <label><input type="checkbox" name="system.equipped" {{#if system.equipped}}checked{{/if}}/> {{localize 'CYPHER.Equipped'}}</label>
    {{#if system.broken}}<span class="shield-broken-badge">{{localize 'CYPHER.Shield.BrokenLabel'}}</span>{{/if}}
  </div>
  <div class="shield-wounds-row">
    <div class="wound-severity wound-minor">
      <label>{{localize 'CYPHER.Wound.minor'}}</label>
      <div class="wound-boxes">
        <input name="system.wounds.minor.current" type="number" value="{{system.wounds.minor.current}}" min="0" max="{{system.wounds.minor.max}}"/>
        <span>/ {{system.wounds.minor.max}}</span>
      </div>
    </div>
    <div class="wound-severity wound-moderate">
      <label>{{localize 'CYPHER.Wound.moderate'}}</label>
      <div class="wound-boxes">
        <input name="system.wounds.moderate.current" type="number" value="{{system.wounds.moderate.current}}" min="0" max="{{system.wounds.moderate.max}}"/>
        <span>/ {{system.wounds.moderate.max}}</span>
      </div>
    </div>
    <div class="wound-severity wound-major">
      <label>{{localize 'CYPHER.Wound.major'}}</label>
      <div class="wound-boxes">
        <input name="system.wounds.major.current" type="number" value="{{system.wounds.major.current}}" min="0" max="{{system.wounds.major.max}}"/>
        <span>/ {{system.wounds.major.max}}</span>
      </div>
    </div>
  </div>
  {{/ifEquals}}

  {{#ifEquals item.type "equipment"}}
  <div class="form-group">
    <label>{{localize 'CYPHER.Equipment.Quantity'}}</label>
    <input name="system.quantity" type="number" value="{{system.quantity}}" min="0"/>
  </div>
  <div class="form-group">
    <label>{{localize 'CYPHER.Equipment.Weight'}}</label>
    <select name="system.weight">
      <option value="none" {{#ifEquals system.weight "none"}}selected{{/ifEquals}}>{{localize 'CYPHER.Weight.none'}}</option>
      <option value="light" {{#ifEquals system.weight "light"}}selected{{/ifEquals}}>{{localize 'CYPHER.Weight.light'}}</option>
      <option value="medium" {{#ifEquals system.weight "medium"}}selected{{/ifEquals}}>{{localize 'CYPHER.Weight.medium'}}</option>
      <option value="heavy" {{#ifEquals system.weight "heavy"}}selected{{/ifEquals}}>{{localize 'CYPHER.Weight.heavy'}}</option>
    </select>
  </div>
  <div class="form-group inline">
    <label>{{localize 'CYPHER.Depletion.Die'}}</label>
    <select name="system.depletionDie">
      <option value="none" {{#ifEquals system.depletionDie "none"}}selected{{/ifEquals}}>{{localize 'CYPHER.Depletion.none'}}</option>
      <option value="d6" {{#ifEquals system.depletionDie "d6"}}selected{{/ifEquals}}>1d6</option>
      <option value="d8" {{#ifEquals system.depletionDie "d8"}}selected{{/ifEquals}}>1d8</option>
      <option value="d10" {{#ifEquals system.depletionDie "d10"}}selected{{/ifEquals}}>1d10</option>
      <option value="d12" {{#ifEquals system.depletionDie "d12"}}selected{{/ifEquals}}>1d12</option>
      <option value="d20" {{#ifEquals system.depletionDie "d20"}}selected{{/ifEquals}}>1d20</option>
    </select>
    <label>{{localize 'CYPHER.Depletion.Threshold'}}
      <input name="system.depletionThreshold" type="number" value="{{system.depletionThreshold}}" min="1"/>
    </label>
  </div>
  {{#ifNotEquals system.depletionDie "none"}}
  <div class="form-group inline">
    <label><input type="checkbox" name="system.depleted" {{#if system.depleted}}checked{{/if}}/> {{localize 'CYPHER.Depletion.Depleted'}}</label>
  </div>
  <p class="depletion-hint">{{localize 'CYPHER.Depletion.EquipmentHint'}}</p>
  {{/ifNotEquals}}
  {{/ifEquals}}

  <div class="form-group description-group">
    <label>{{localize 'CYPHER.Description'}}</label>
    <prose-mirror name="system.description" value="{{system.description}}"></prose-mirror>
  </div>
  {{/ifEquals}}
  {{/ifEquals}}
  {{/ifEquals}}

</section>
