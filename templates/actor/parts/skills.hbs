{{!-- PC skill table; its item IDs and action attributes let the sheet update the right documents. --}}
<section class="tab skills {{tab.cssClass}}" data-group="primary" data-tab="skills">
  <button type="button" class="item-create" data-action="itemCreate" data-type="skill">
    <i class="fa-solid fa-plus"></i> {{localize 'CYPHER.Skill.New'}}
  </button>
  <div class="proficiency-summary">
    <h3>{{localize 'CYPHER.Proficiency.Title'}}</h3>
    <div class="proficiency-groups">
      <div>
        <h4>{{localize 'CYPHER.Proficiency.WeaponCategories'}}</h4>
        <ul>
          {{#each system.freeWeaponCategories as |category|}}
          <li>{{localize (concat 'CYPHER.AttackType.' category)}} — {{localize 'CYPHER.Proficiency.Practiced'}}</li>
          {{/each}}
          {{#each system.freeWeaponSkillCategories as |category|}}
          <li>{{localize (concat 'CYPHER.AttackSkill.' category)}} — {{localize 'CYPHER.Proficiency.Practiced'}}</li>
          {{/each}}
          {{#unless system.freeWeaponCategories.length}}
          {{#unless system.freeWeaponSkillCategories.length}}<li>{{localize 'CYPHER.Proficiency.None'}}</li>{{/unless}}
          {{/unless}}
        </ul>
      </div>
      <div>
        <h4>{{localize 'CYPHER.Proficiency.WeaponFamilies'}}</h4>
        <ul>
          {{#each system.freeWeaponFamilies as |family|}}
          <li>{{localize (concat 'CYPHER.WeaponFamily.' family)}} — {{localize 'CYPHER.Proficiency.Practiced'}}</li>
          {{else}}
          <li>{{localize 'CYPHER.Proficiency.None'}}</li>
          {{/each}}
        </ul>
      </div>
      <div>
        <h4>{{localize 'CYPHER.Proficiency.ArmorCategories'}}</h4>
        <ul>
          {{#each system.freeArmorCategories as |category|}}
          <li>{{localize (concat 'CYPHER.Armor.' category)}} — {{localize 'CYPHER.Proficiency.Practiced'}}</li>
          {{else}}
          <li>{{localize 'CYPHER.Proficiency.None'}}</li>
          {{/each}}
        </ul>
      </div>
    </div>
  </div>
  <ul class="item-list skills-list">
    <li class="item-list-header">
      <span class="skill-name">{{localize 'CYPHER.Name'}}</span>
      <span class="skill-stat">{{localize 'CYPHER.Stat.Label'}}</span>
      <span class="skill-level">{{localize 'CYPHER.Skill.Level'}}</span>
      <span class="skill-controls"></span>
    </li>
    {{#each items.skills as |item|}}
    <li class="item" data-item-id="{{item.id}}">
      <span class="skill-name">{{item.name}}</span>
      <span class="skill-stat">{{localize (concat "CYPHER.Stat." item.system.stat)}}</span>
      <span class="skill-level skill-level-{{item.system.level}}">{{localize (concat "CYPHER.SkillLevel." item.system.level)}}</span>
      <span class="skill-controls">
        <a data-action="itemEdit"><i class="fa-solid fa-edit"></i></a>
        <a data-action="itemDelete"><i class="fa-solid fa-trash"></i></a>
      </span>
    </li>
    {{/each}}
  </ul>
</section>
