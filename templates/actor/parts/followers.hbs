<section class="pc-section">
  <div class="pc-section-heading compact pc-wrap-heading"><h2>{{localize "CYPHER.Follower.title"}}</h2>
    {{#if followerCanManage}}<button type="button" data-action="promptFollowerAbility">{{localize "CYPHER.FollowerAbility.apply"}}</button>
    <button type="button" data-action="promptFollower">{{localize "CYPHER.Follower.register"}}</button>{{/if}}
  </div>
  <p>{{localize "CYPHER.Follower.helpHint"}}</p>
  {{#if followerCanManage}}
    {{#each commands.choices as |choice|}}<button type="button" data-action="promptCommandPower" data-item-id="{{choice.id}}">{{choice.name}}</button>{{/each}}
    {{#each commands.calms as |calm|}}<p>{{calm.name}} · {{#if calm.active}}{{localize "CYPHER.Command.calm"}}{{else}}{{localize "CYPHER.Command.inactiveCalm"}}{{/if}}
      {{#ifEquals calm.state "pending"}}<button type="button" data-action="promptCommandAction" data-command="resumeCalm" data-command-id="{{calm.id}}">{{localize "CYPHER.Command.resume"}}</button>{{/ifEquals}}
      {{#if calm.maintainable}}<button type="button" data-action="promptCommandAction" data-command="maintain" data-command-id="{{calm.id}}">{{localize "CYPHER.Command.maintain"}}</button>{{/if}}
      <button type="button" data-action="promptCommandAction" data-command="endCalm" data-command-id="{{calm.id}}">{{localize "CYPHER.Command.end"}}</button></p>{{/each}}
    {{#ifEquals commands.lighting.state "pending"}}<button type="button" data-action="promptCommandAction" data-command="resumeLighting">{{localize "CYPHER.Command.resume"}}</button>{{/ifEquals}}
    {{#each commands.allies as |ally|}}<p>{{ally.name}} · {{localize ally.stateLabel}} · {{ally.adaptation}}
      {{#if ally.pending}}<button type="button" data-action="promptCommandAction" data-command="resumeAlly" data-command-id="{{ally.id}}">{{localize "CYPHER.Command.resume"}}</button>
      {{else}}<button type="button" data-action="promptCommandAction" data-command="invite" data-command-id="{{ally.id}}">{{localize "CYPHER.Command.invite"}}</button>
      <button type="button" data-action="promptCommandAction" data-command="endOuting" data-command-id="{{ally.id}}">{{localize "CYPHER.Command.endOuting"}}</button>
      <button type="button" data-action="promptCommandAction" data-command="mode" data-command-id="{{ally.id}}">{{localize "CYPHER.Command.mode"}}</button>{{/if}}</p>{{/each}}
    {{#each temporary.choices as |choice|}}<button type="button" data-action="promptTemporaryFollower" data-item-id="{{choice.id}}">{{choice.name}}</button>{{/each}}
    {{#each temporary.pending as |use|}}<button type="button" data-action="resumeTemporaryFollower" data-use-id="{{use.id}}">{{localize "CYPHER.Temporary.resume"}}</button>
    <button type="button" data-action="abandonTemporaryFollower" data-use-id="{{use.id}}">{{localize "CYPHER.Temporary.abandon"}}</button>{{/each}}
    <button type="button" data-action="settleTemporaryDeaths">{{localize "CYPHER.Temporary.settleDeaths"}}</button>
    {{#each temporary.records as |record|}}{{#if record.rebooting}}<button type="button" data-action="promptTemporaryReboot" data-record-id="{{record.id}}">{{localize "CYPHER.Temporary.finishReboot"}}</button>{{/if}}{{/each}}
  {{/if}}
  <button type="button" data-action="promptCompanionContext">{{localize "CYPHER.Companion.circumstances"}}</button>
  {{#if followerCanManage}}
  <button type="button" data-action="promptCompanionInstall">{{localize "CYPHER.CompanionUpgrade.install"}}</button>
  {{#each companionUpgrades.installations as |binding|}}<p>{{binding.name}}
    {{#if binding.flight}}<button type="button" data-action="promptCompanionUpgradeCircumstances" data-follower-id="{{binding.followerId}}">{{localize "CYPHER.CompanionUpgrade.circumstances"}}</button>
    {{else}}<button type="button" data-action="promptCompanionUpgrade" data-binding-id="{{binding.id}}">{{localize "CYPHER.CompanionUpgrade.activate"}}</button>{{/if}}</p>{{/each}}
  {{#each companionUpgrades.offers as |offer|}}{{#if offer.senses}}<button type="button" data-action="promptCompanionUpgrade" data-item-id="{{offer.id}}">{{offer.name}}</button>{{/if}}{{/each}}
  {{#each companionUpgrades.effects as |effect|}}<p>{{effect.name}}
    {{#if effect.pending}}<button type="button" data-action="finishCompanionUpgrade" data-effect-id="{{effect.id}}">{{localize "CYPHER.CompanionUpgrade.resume"}}</button>
    {{else}}<button type="button" data-action="stopCompanionUpgrade" data-effect-id="{{effect.id}}">{{localize "CYPHER.CompanionUpgrade.end"}}</button>
    {{#if effect.senses}}<button type="button" data-action="promptCompanionUpgradeCircumstances" data-effect-id="{{effect.id}}">{{localize "CYPHER.CompanionUpgrade.circumstances"}}</button>{{/if}}
    {{#if effect.field}}<button type="button" data-action="promptCompanionUpgradeCircumstances" data-effect-id="{{effect.id}}">{{localize "CYPHER.CompanionUpgrade.circumstances"}}</button>{{/if}}
    {{#if effect.turret}}<button type="button" data-action="promptAutomatonTurret" data-effect-id="{{effect.id}}">{{localize "CYPHER.CompanionUpgrade.fire"}}</button>{{/if}}{{/if}}</p>{{/each}}
  {{/if}}
  {{#if companion}}<p>{{companion.npc.name}} · {{#if companion.immediate}}{{localize "CYPHER.Companion.immediate"}} · {{/if}}{{#if companion.alive}}{{localize "CYPHER.Companion.alive"}}{{/if}}{{#if companion.riding}} · {{localize "CYPHER.Companion.riding"}}{{/if}}</p>{{/if}}
  {{#each companionSupport.repairs as |repair|}}<p>{{localize "CYPHER.Companion.repair"}} · {{repair.remaining}} s
    <button type="button" data-action="finishCompanionRepair" data-repair-id="{{repair.id}}">{{localize "CYPHER.Companion.finishRepair"}}</button>
    {{#if repair.working}}<button type="button" data-action="cancelCompanionRepair" data-repair-id="{{repair.id}}">{{localize "CYPHER.Companion.cancelRepair"}}</button>{{/if}}</p>{{/each}}
  {{#if followerCanManage}}{{#each companionSupport.interceptions as |interception|}}<p>{{localize "CYPHER.Companion.pendingInterception"}}
    <button type="button" data-action="resumeRetainerInterception" data-interception-id="{{interception.id}}">{{localize "CYPHER.Companion.resume"}}</button></p>{{/each}}{{/if}}
  {{#if followerCanManage}}{{#each followerAbilityPending as |use|}}
    <p>{{use.source}} · {{localize "CYPHER.Follower.pending"}} <button type="button" data-action="resumeFollowerAbility" data-use-id="{{use.id}}">{{localize "CYPHER.FollowerAbility.resume"}}</button></p>
  {{/each}}{{/if}}
  {{#each followers as |follower|}}
  <article class="pc-table-row pc-flex-row" data-follower-id="{{follower.id}}">
    <div><strong>{{follower.name}}</strong><span>{{localize "CYPHER.Follower.level"}} {{follower.level}} · {{follower.health.value}}/{{follower.health.max}}</span>
      <p>{{localize follower.modeLabel}} · {{localize follower.stateLabel}}{{#if follower.unavailable}} · {{localize "CYPHER.Follower.absent"}}{{/if}}</p>
      {{#each follower.tasks as |task|}}<span>{{task.label}}: {{task.level}} </span>{{/each}}
      {{#if follower.flight.enabled}}<p>{{#if follower.flight.meters}}{{localize "CYPHER.CompanionUpgrade.carryingFlight"}}{{else}}{{localize "CYPHER.CompanionUpgrade.longFlight"}}{{/if}}</p>{{/if}}
      {{#if follower.turretPending}}<p>{{localize "CYPHER.CompanionUpgrade.pendingShot"}}</p>{{/if}}
    </div>
    {{#if follower.teamUp}}
    <span>{{localize "CYPHER.Command.allyHint"}}</span>
    {{else}}{{#if follower.temporary}}
    {{#if ../followerCanManage}}
    <button type="button" data-action="promptTemporaryMode" data-record-id="{{follower.id}}">{{localize "CYPHER.Temporary.mode"}}</button>
    <button type="button" data-action="openTemporaryFollower" data-record-id="{{follower.id}}">{{localize "CYPHER.Follower.open"}}</button>
    {{#if follower.dismissible}}<button type="button" data-action="dismissTemporaryInstance" data-record-id="{{follower.id}}">{{localize "CYPHER.Temporary.dismiss"}}</button>{{/if}}
    {{/if}}
    {{else}}
    <button type="button" data-action="configureFollower" data-follower-id="{{follower.id}}">{{localize "CYPHER.Follower.configure"}}</button>
    <button type="button" data-action="syncFollower" data-follower-id="{{follower.id}}">{{localize "CYPHER.Follower.sync"}}</button>
    {{#if follower.canRepair}}<button type="button" data-action="promptCompanionRepair" data-follower-id="{{follower.id}}">{{localize "CYPHER.Companion.repair"}}</button>{{/if}}
    {{#if ../followerCanManage}}
    <button type="button" data-action="openFollower" data-follower-id="{{follower.id}}">{{localize "CYPHER.Follower.open"}}</button>
    <button type="button" data-action="replaceFollower" data-follower-id="{{follower.id}}">{{localize "CYPHER.Follower.replace"}}</button>
    {{#ifEquals follower.state "manual"}}<button type="button" data-action="reconcileFollower" data-follower-id="{{follower.id}}">{{localize "CYPHER.Follower.reconcile"}}</button>{{/ifEquals}}
    {{/if}}
    {{/if}}
    {{/if}}
  </article>
  {{else}}<p>{{localize "CYPHER.Follower.empty"}}</p>{{/each}}
</section>
