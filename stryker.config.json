{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "npm run test:unit"
  },
  "mutate": [
    "module/rules/*.mjs"
  ],
  "ignorePatterns": [
    "docs/**",
    ".git/**",
    ".stryker-tmp/**",
    "coverage/**",
    "reports/**"
  ],
  "coverageAnalysis": "off",
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 0
  },
  "concurrency": 2,
  "timeoutMS": 10000,
  "cleanTempDir": "always"
}
